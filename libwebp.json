{
    "name": "libwebp",
    "version": "1.0.2",
    "description": "WebP image decoder",
    "filters":["webpdec"],
    "help": "This filter decodes WebP images (lossy, lossless and alpha) using libwebp.",
    "support": [
        "image"
    ],
    "sources":"https://bevara.ddns.net/sources/libwebp.accessor",
    "filter_source":{
        "webpdec" : "dec_webp.c"
    },
    "extension":{
      "webp" : "img"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1", "mm_solver_1.0.2", "mm_solver_1.0.3", "mm_solver_1.0.4"],
    "patents": {
        "status": "royalty-free",
        "note": "WebP, royalty-free grant from Google",
        "checked": "2026-10-16"
    }
}
